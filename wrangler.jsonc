// Instellingen voor de spelserver op Cloudflare Workers.
// Dit bestand staat in de hoofdmap, zodat Cloudflare het vanzelf vindt als je
// de repo koppelt. Zelf uitrollen kan met `npx wrangler deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "muziek-tijdlijn",
  "main": "server/cloudflare/worker.js",
  "compatibility_date": "2026-06-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }]
  },
  // Het gratis plan van Cloudflare vraagt Durable Objects met SQLite-opslag.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "vars": {
    // Waar de server de lijst met nummers ophaalt.
    "TRACKS_URL": "https://baaswietse.github.io/muziek-tijdlijn/tracks.json",
    // Alleen de eigen site mag de server gebruiken.
    "ALLOWED_ORIGINS": "https://baaswietse.github.io"
  },
  "observability": { "enabled": true }
}
